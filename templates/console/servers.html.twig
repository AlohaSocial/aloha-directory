{% extends 'console/base.html.twig' %}
{% import 'console/_macros.html.twig' as m %}
{% block title %}Servers{% endblock %}
{% block content %}
<h1>Servers</h1>
<form method="get" class="filters">
    <label>State
        <select name="state">
            <option value="">All</option>
            {% for s in states %}<option value="{{ s.value }}" {% if state and state.value == s.value %}selected{% endif %}>{{ s.label }} ({{ counts[s.value] }})</option>{% endfor %}
        </select>
    </label>
    <label>Search <input type="search" name="q" value="{{ q }}" placeholder="domain or name"></label>
    <button type="submit">Filter</button>
</form>
<table>
    <thead><tr><th>Server</th><th>State</th><th>Last heartbeat</th><th>Capacity</th><th>Version</th><th>Weight</th><th>Next review</th></tr></thead>
    <tbody>
    {% for s in servers %}
        <tr>
            <td><a href="{{ path('console_server', {domain: s.domain}) }}">{{ s.displayName }}</a><br><span class="muted">{{ s.domain }}</span></td>
            <td>{{ m.state(s) }}</td>
            <td>{{ m.date(s.lastHeartbeatAt) }}</td>
            <td>{{ s.availableAccounts is null ? '—' : (s.isFull ? 'full' : s.availableAccounts ~ ' free') }}</td>
            <td>{{ m.value(s.softwareVersion) }}</td>
            <td>{{ s.weight }}</td>
            <td>{{ m.date(s.nextReviewAt) }}</td>
        </tr>
    {% else %}
        <tr><td colspan="7" class="empty">No servers.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
