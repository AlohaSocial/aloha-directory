{% extends 'console/base.html.twig' %}
{% import 'console/_macros.html.twig' as m %}
{% block title %}Block list{% endblock %}
{% block content %}
<h1>Block list</h1>
<p>A blocked domain blocks all its subdomains. Blocked domains cannot enrol; a listed server that becomes blocked is paused by the next check. Shared lists are imported with <code>bin/console app:blocklist:import</code>.</p>
<div class="grid2">
<section class="card">
    <h2>Sources</h2>
    <ul>{% for s in sources %}<li>{{ s.source }}: {{ s.n }} domains</li>{% else %}<li class="empty">No entries.</li>{% endfor %}</ul>
    <form method="get" class="filters"><label>Find a domain <input type="search" name="q" value="{{ q }}"></label><button type="submit">Search</button></form>
    {% if q %}<ul>{% for b in matches %}<li>{{ b.domain }} ({{ b.source }}): {{ b.reason }}</li>{% else %}<li class="empty">No match.</li>{% endfor %}</ul>{% endif %}
</section>
<section class="card">
    <h2>Add to the directory's own list</h2>
    <form method="post" action="{{ path('console_blocklist_add') }}" class="stack">
        {{ m.csrf() }}
        <label>Domain <input type="text" name="domain" required maxlength="253"></label>
        <label>Reason <input type="text" name="reason" required maxlength="500"></label>
        <button type="submit">Block</button>
    </form>
</section>
</div>
<h2>The directory's own list</h2>
<table>
    <thead><tr><th>Domain</th><th>Reason</th><th>Since</th><th></th></tr></thead>
    <tbody>
    {% for b in own %}
        <tr><td>{{ b.domain }}</td><td>{{ b.reason }}</td><td>{{ m.date(b.createdAt) }}</td>
            <td><form method="post" action="{{ path('console_blocklist_remove', {id: b.id}) }}">{{ m.csrf() }}<button type="submit" class="link">Remove</button></form></td></tr>
    {% else %}<tr><td colspan="4" class="empty">Empty.</td></tr>{% endfor %}
    </tbody>
</table>
{% endblock %}
