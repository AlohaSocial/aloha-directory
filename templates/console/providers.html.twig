{% extends 'console/base.html.twig' %}
{% import 'console/_macros.html.twig' as m %}
{% block title %}Search providers{% endblock %}
{% block content %}
<h1>Search providers</h1>
<p>Listed servers that offer search to other servers (concept 10). A server becomes a provider when a curator accepts it; it is published only while its heartbeat confirms the capabilities.</p>
<table>
    <thead><tr><th>Server</th><th>State</th><th>Offered</th><th>Switched on</th><th>Rate limit</th><th>Log retention</th><th>Load</th><th>Index policy</th></tr></thead>
    <tbody>
    {% for s in servers %}
        <tr>
            <td><a href="{{ path('console_server', {domain: s.domain}) }}">{{ s.displayName }}</a><br><span class="muted">{{ s.domain }}</span></td>
            <td>{{ m.state(s) }}</td>
            <td>{{ (s.profile.search.capabilities ?? [])|join(', ') ?: '—' }}</td>
            <td>{{ s.heartbeatSearch ? s.heartbeatSearch|join(', ') : '—' }}</td>
            <td>{{ s.profile.search.rate_limit_per_minute ?? '—' }}/min</td>
            <td>{{ s.profile.search.log_retention_days ?? '—' }} days</td>
            <td>{{ s.searchLoad is null ? '—' : (s.searchLoad * 100)|round ~ ' %' }}</td>
            <td>{% if s.profile.search.index_policy_url ?? null %}<a href="{{ s.profile.search.index_policy_url }}" rel="noopener noreferrer nofollow">policy</a>{% else %}—{% endif %}</td>
        </tr>
    {% else %}
        <tr><td colspan="8" class="empty">No server offers search yet.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
