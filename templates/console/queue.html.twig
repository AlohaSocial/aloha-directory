{% extends 'console/base.html.twig' %}
{% import 'console/_macros.html.twig' as m %}
{% block title %}Queue{% endblock %}
{% block content %}
<h1>Queue</h1>
<nav class="tabs" aria-label="Queue">
    {% for key, label in tabs %}
        <a href="{{ path('console_queue', {tab: key}) }}" {% if key == tab %}aria-current="page"{% endif %}>{{ label }} <span class="count">{{ counts[key] }}</span></a>
    {% endfor %}
</nav>

{% if items is empty %}
    <p class="empty">Nothing waiting here.</p>
{% elseif tab == 'proposals' %}
    <table>
        <thead><tr><th>Server</th><th>Proposal</th><th>Reason</th><th>By</th><th>Since</th></tr></thead>
        <tbody>
        {% for p in items %}
            <tr>
                <td><a href="{{ path('console_server', {domain: p.server.domain}) }}">{{ p.server.domain }}</a></td>
                <td>{{ p.action.label }}{% if p.params.weight_percent is defined %} → {{ p.params.weight_percent / 100 }}{% endif %}</td>
                <td>{{ p.reason|length > 120 ? p.reason|slice(0, 120) ~ '…' : p.reason }}</td>
                <td>{{ p.proposedBy ? p.proposedBy.displayName : '—' }}{% if p.proposedBy and p.proposedBy.id == me.id %} <span class="badge">you</span>{% endif %}</td>
                <td>{{ m.date(p.proposedAt) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% elseif tab == 'complaints' %}
    <table>
        <thead><tr><th>Server</th><th>Category</th><th>Status</th><th>Received</th></tr></thead>
        <tbody>
        {% for c in items %}
            <tr>
                <td><a href="{{ path('console_complaint', {id: c.id}) }}">{{ c.server.domain }}</a></td>
                <td>{{ c.category }}</td>
                <td>{{ c.status.value }}</td>
                <td>{{ m.date(c.createdAt) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% else %}
    <table>
        <thead><tr><th>Server</th><th>State</th><th>
            {% if tab == 'reviews' %}Review due{% elseif tab == 'paused' %}Paused since{% elseif tab == 'profiles' %}Changed{% else %}Since{% endif %}
        </th><th>Note</th></tr></thead>
        <tbody>
        {% for s in items %}
            <tr>
                <td><a href="{{ path('console_server', {domain: s.domain}) }}">{{ s.displayName }}</a><br><span class="muted">{{ s.domain }}</span></td>
                <td>{{ m.state(s) }}</td>
                <td>
                    {% if tab == 'reviews' %}{{ m.date(s.nextReviewAt) }}
                    {% elseif tab == 'paused' %}{{ m.date(s.pausedAt) }}
                    {% elseif tab == 'profiles' %}{{ m.date(s.profileUpdatedAt) }}
                    {% elseif tab == 'applications' %}{{ m.date(s.inReviewAt) }}
                    {% else %}{{ m.date(s.appliedAt) }}{% endif %}
                </td>
                <td>{% if tab == 'paused' %}{{ s.pauseReason }}{% endif %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
