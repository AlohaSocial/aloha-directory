<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content="{% block description %}The Aloha Directory lists curated Aloha servers, with the rules they follow and how they are reviewed.{% endblock %}">
    <title>{% block title %}Aloha Directory{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%230f7c80'/%3E%3Cpath d='M6 19c3-3 6-3 10 0s7 3 10 0' stroke='%23fff' stroke-width='2.5' fill='none' stroke-linecap='round'/%3E%3C/svg%3E">
    <link rel="stylesheet" href="/assets/site.css">
    <script src="/assets/site.js" defer></script>
</head>
{% set active = active|default('') %}
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <div class="wrap header-inner">
            <a class="brand" href="/">
                <span class="brand-mark" aria-hidden="true"></span>
                <span class="brand-name">Aloha Directory</span>
            </a>
            <nav class="site-nav" aria-label="Main">
                <ul>
                    {% for item in [
                        {key: 'servers', href: '/', label: 'Servers'},
                        {key: 'covenant', href: '/covenant/', label: 'Covenant'},
                        {key: 'criteria', href: '/criteria/', label: 'Listing criteria'},
                        {key: 'transparency', href: '/transparency/', label: 'Transparency'},
                        {key: 'keys', href: '/keys/', label: 'Signing keys'},
                        {key: 'report', href: '/report', label: 'Report a server'},
                    ] %}
                        <li><a href="{{ item.href }}"{% if active == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
        </div>
    </header>

    <main id="main" class="wrap" tabindex="-1">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="wrap footer-inner">
            <p>
                Lists signed with Ed25519.
                {% if list_serial is defined and list_serial is not null %}
                    Server list serial <strong>{{ list_serial }}</strong>{% if list_issued_at is defined and list_issued_at is not null %}, issued {{ list_issued_at }}{% endif %}.
                {% endif %}
            </p>
            <ul class="footer-links">
                <li><a href="/privacy/">Privacy</a></li>
                <li><a href="/keys/">How to verify a list</a></li>
                <li><a href="https://github.com/AlohaSocial/aloha-directory">Source code (AGPL 3.0 or later)</a></li>
            </ul>
        </div>
    </footer>
</body>
</html>
